# ================= agent2api configuration =================
# Copy to .env and fill in. NO vendor-specific values are shipped in this
# repository: everything below marked "capture" comes from YOUR own packet
# capture of the web app you want to wrap. See PROTOCOL.md for the method.

# ---- Local proxy ----
PORT=9317
HOST=127.0.0.1
# API key clients must send as "Authorization: Bearer <key>". Empty = auth off.
API_KEY=change-me-locally

# ---- Captured from traffic: host & cookies ----
# The base URL of the web app's API (scheme + host only, no path).
UPSTREAM_BASE=
# The two auth cookies (names AND values) the web app sends after login.
# COOKIE_CFTK_NAME = the CSRF-style token cookie name; CFTK = its value.
COOKIE_CFTK_NAME=
CFTK=
# Session cookie name and value.
COOKIE_SESSION_NAME=
SESSION_ID=
# Header that carries the token alongside the cookie, if the app uses one
# (name only, value is taken from CFTK). Leave empty if none.
TOKEN_HEADER_NAME=

# ---- Captured from traffic: endpoints (paths, prefixed with UPSTREAM_BASE) ----
# Session create: POST, body {}, response JSON result.session_id
EP_SESSION_CREATE=
# Session delete path, {id} is replaced with the session id
EP_SESSION_DELETE=/{id}
# Messages endpoint: POST, SSE response, {id} = session id
EP_MESSAGES=
# Agent model list (if the app has one); {agent_id} replaced by AGENT_ID
EP_AGENT_MODELS=
AGENT_ID=
# Benefit/free-channel model list endpoint
EP_BENEFIT_MODELS=
# Legacy builtin model list endpoint (fallback)
EP_LEGACY_MODELS=

# ---- Captured from traffic: extra headers ----
# "Name: value" pairs separated by | . Two sets: chat calls and list calls.
HEADERS_CHAT=
HEADERS_LIST=
# Marker header that selects the free channel on the messages endpoint,
# e.g. X-Channel: free. Leave empty if the app has no such concept.
BENEFIT_HEADER=

# ---- Models ----
# Default model when the request does not specify one
DEFAULT_MODEL=
# Models routed via the free channel (comma separated ids; BENEFIT_HEADER
# is attached to their messages calls)
BENEFIT_MODELS=
